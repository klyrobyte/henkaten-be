APP_NAME=Henkaten

# ─── ENVIRONMENT MODE ────────────────────────────────────────────────────────
# local       → PC dev, artisan serve on localhost. CSP allows all localhost:*.
# development → Shared dev / hotspot LAN. CSP still allows all localhost:*.
# production  → Deployment server OR bound LAN IP. CSP locks to APP_URL only.
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# ─── APP URL  - ONE value controls everything ──────────────────────────────────
# This drives: tryItOutBaseUrl, CSP connect-src, session cookies, asset URLs.
#
#  Local PC (artisan serve default):
#    APP_URL=http://localhost:8000
#    APP_ENV=local
#
#  LAN / Hotspot (phone/tablet testing on same network):
#    APP_URL=http://192.168.x.x:8000      ← your machine's LAN IP
#    APP_ENV=production                   ← locks CSP to this IP only
#
#  Deployment server with a real domain:
#    APP_URL=https://yourdomain.com
#    APP_ENV=production                   ← enables HSTS, HTTPS upgrade, strict CSP
# ─────────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sechenten
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to false for local/LAN http:// access, true for https:// production
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Security Patch 2026-05-10 ────────────────────────────────────────────────
# APP_API_SECRET: HMAC key for service/app clients.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_API_SECRET=your-64-char-hex-secret-here

# ─── Scribe API Docs ──────────────────────────────────────────────────────────
# Set false in production to disable /docs entirely.
SCRIBE_ENABLED=true

# Comma-separated IPs allowed to view /docs. Use * to allow all.
SCRIBE_ALLOWED_IPS=127.0.0.1,::1
